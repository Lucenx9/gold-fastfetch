{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "left": 2, "right": 3 } },
  "display": {
    "separator": " ", "showErrors": false, "disableLinewrap": true,
    "color": { "keys": "cyan", "title": "light_magenta" },
    "brightColor": true, "key": { "width": 18 },
    "size": { "ndigits": 1, "binaryPrefix": "iec" },
    "temp": { "unit": "C", "ndigits": 0 },
    "duration": { "abbreviation": true },
    "bar": { "width": 10, "char": { "elapsed": "━", "total": "━" }, "border": { "left": "", "right": "" } },
    "percent": { "type": 3, "ndigits": 0 }
  },
  "modules": [
    { "type": "custom", "format": "╭──────────────────────────────────────────────────────────", "outputColor": "cyan" },

    { "type": "title", "key": "│ User", "keyColor": "light_magenta", "format": "{user-name}" },
    { "type": "title", "key": "│ Host", "keyColor": "light_magenta", "format": "{host-name}" },
    { "type": "datetime", "key": "│ Time", "keyColor": "light_magenta", "format": "{year}-{month}-{day-in-month} {hour}:{minute}" },

    { "type": "custom", "format": "├──────────────────────────────────────────────────────────", "outputColor": "cyan" },

    { "type": "os", "key": "│ OS", "keyColor": "cyan" },
    { "type": "kernel", "key": "│ Kernel", "keyColor": "cyan" },
    { "type": "uptime", "key": "│ Uptime", "keyColor": "cyan" },
    { "type": "command", "key": "│ Updates", "keyColor": "yellow", "text": "bash \"{{SCRIPTS_DIR}}/updates.sh\"" },
    { "type": "packages", "key": "│ Packages", "keyColor": "cyan", "format": "{all} (pacman {pacman}, flatpak {flatpak-all})" },
    { "type": "command", "key": "│ Foreign", "keyColor": "cyan", "text": "pacman -Qmq 2>/dev/null | wc -l" },
    { "type": "shell", "key": "│ Shell", "keyColor": "cyan" },
    { "type": "locale", "key": "│ Locale", "keyColor": "cyan" },
    { "type": "de", "key": "│ Desktop", "keyColor": "cyan" },
    { "type": "wm", "key": "│ WM", "keyColor": "cyan" },
    { "type": "terminal", "key": "│ Terminal", "keyColor": "cyan" },
    { "type": "terminalfont", "key": "│ Term Font", "keyColor": "cyan" },

    { "type": "custom", "format": "├──────────────────────────────────────────────────────────", "outputColor": "green" },

    { "type": "cpu", "key": "│ CPU", "keyColor": "green", "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}" },
    { "type": "command", "key": "│ GPU", "keyColor": "green", "text": "bash \"{{SCRIPTS_DIR}}/gpu_detect.sh\"" },
    { "type": "memory", "key": "│ RAM", "keyColor": "green", "format": "{used} / {total} ({percentage})" },
    { "type": "swap", "key": "│ Swap", "keyColor": "green", "format": "{used} / {total} ({percentage})" },
    { "type": "battery", "key": "│ Battery", "keyColor": "green", "format": "{capacity}% ({status})" },
    { "type": "command", "key": "│ Disks", "keyColor": "green", "text": "bash \"{{SCRIPTS_DIR}}/disk_detect.sh\"" },

    { "type": "custom", "format": "├──────────────────────────────────────────────────────────", "outputColor": "blue" },

    { "type": "display", "key": "│ Display", "keyColor": "blue", "format": "{name} {width}x{height} @ {refresh-rate}Hz" },
    { "type": "sound", "key": "│ Audio", "keyColor": "blue" },
    { "type": "theme", "key": "│ Theme", "keyColor": "blue" },
    { "type": "icons", "key": "│ Icons", "keyColor": "blue" },
    { "type": "font", "key": "│ Sys Fonts", "keyColor": "blue" },
    { "type": "cursor", "key": "│ Cursor", "keyColor": "blue" },
    { "type": "gamepad", "key": "│ Gamepad", "keyColor": "blue" },
    { "type": "localip", "key": "│ Local IP", "keyColor": "blue", "compact": true, "showIpv4": true, "showIpv6": false, "defaultRouteOnly": true },

    { "type": "custom", "format": "├──────────────────────────────────────────────────────────", "outputColor": "yellow" },
    { "type": "player", "key": "│ Player", "keyColor": "yellow" },
    { "type": "media", "key": "│ Playing", "keyColor": "yellow" },

    { "type": "custom", "format": "├──────────────────────────────────────────────────────────", "outputColor": "magenta" },
    { "type": "colors", "key": "│ Palette", "keyColor": "magenta", "symbol": "circle" },
    { "type": "custom", "format": "╰──────────────────────────────────────────────────────────", "outputColor": "magenta" }
  ]
}
