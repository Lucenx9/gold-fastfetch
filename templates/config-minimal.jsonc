{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "left": 2, "right": 3 } },
  "display": {
    "separator": " → ",
    "showErrors": false,
    "disableLinewrap": true,
    "color": { "keys": "cyan" },
    "brightColor": true,
    "size": { "ndigits": 1, "binaryPrefix": "iec" },
    "temp": { "unit": "C", "ndigits": 0 }
  },
  "modules": [
    { "type": "os", "key": "{{I_OS}}OS", "keyColor": "cyan" },
    { "type": "kernel", "key": "{{I_KER}}Kernel", "keyColor": "cyan" },
    { "type": "uptime", "key": "{{I_UP}}Uptime", "keyColor": "cyan" },
    { "type": "shell", "key": "{{I_SH}}Shell", "keyColor": "cyan" },
    { "type": "cpu", "key": "{{I_CPU}}CPU", "keyColor": "cyan" },
    { "type": "memory", "key": "{{I_RAM}}RAM", "keyColor": "cyan", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "{{I_DISK}}Disk", "keyColor": "cyan" },
    { "type": "colors", "key": "{{I_PAL}}Palette", "keyColor": "cyan", "symbol": "circle" }
  ]
}
